{
  "name": "aether-holographic-interface",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"tsx watch server/index.ts\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "assets": "node scripts/assets.mjs",
    "predev": "node scripts/assets.mjs",
    "prebuild": "node scripts/assets.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@mediapipe/tasks-vision": "0.10.32",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "three": "^0.180.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
